# MediScript Backend Configuration
PROJECT_NAME="MediScript Clinical API"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Supabase Configuration
# Required for live database access and user authentication verification
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-for-token-verification"

# AI Voice Structuring & Refinement Provider (Optional)
# Supported values: "none", "gemini", "openai"
AI_PROVIDER="none"
AI_API_KEY=""

# Logging & Operational Parameters
LOG_LEVEL="INFO"
